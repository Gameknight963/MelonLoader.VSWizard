<?xml version="1.0" encoding="utf-8"?>
<VSTemplate Version="3.0.0" Type="Project" xmlns="http://schemas.microsoft.com/developer/vstemplate/2005" xmlns:sdk="http://schemas.microsoft.com/developer/vstemplate-sdkextension/2010">
  <TemplateData>
    <Name>MelonLoader Mod (Mono and IL2CPP)</Name>
    <Description>A mod with separate Mono and IL2CPP references and builds. Select one installation of each runtime.</Description>
    <Icon>MelonLoader.VSWizard.DualRuntimeModTemplate.ico</Icon>
    <ProjectType>CSharp</ProjectType>
    <LanguageTag>csharp</LanguageTag>
    <SortOrder>1000</SortOrder>
    <TemplateID>132826d8-19c5-45d1-9f8e-76a17a9638d6</TemplateID>
    <CreateNewFolder>true</CreateNewFolder>
    <DefaultName>MelonLoaderMod</DefaultName>
    <ProvideDefaultName>true</ProvideDefaultName>
  </TemplateData>
  <TemplateContent>
    <Project File="ProjectTemplate.csproj" ReplaceParameters="true">
      <ProjectItem ReplaceParameters="true" OpenInEditor="true">Core.cs</ProjectItem>
      <ProjectItem ReplaceParameters="true">Directory.Build.props</ProjectItem>
      <ProjectItem ReplaceParameters="true" TargetFileName="$safeprojectname$.slnx">Solution.slnx</ProjectItem>
    </Project>
  </TemplateContent>
  <WizardExtension>
    <Assembly>MelonLoader.VSWizard.WizardExtension, Version=1.0.0.0, Culture=Neutral, PublicKeyToken=246ede3953d2ce5e</Assembly>
    <FullClassName>MelonLoader.VSWizard.WizardExtension.DualRuntimeWizardImplementation</FullClassName>
  </WizardExtension>
</VSTemplate>